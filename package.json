{
  "name": "technovation-2026",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --watch backend/src/server.js",
    "start": "node backend/src/server.js",
    "db:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "db:validate": "prisma validate --schema backend/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema backend/prisma/schema.prisma",
    "db:seed": "node backend/prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "csv-parse": "7.0.3",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "multer": "2.5.0",
    "pdfkit": "0.17.2",
    "prisma": "6.19.3",
    "qrcode": "1.5.4",
    "sharp": "0.35.5"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  }
}
