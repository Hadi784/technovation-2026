DATABASE_URL=postgresql://technovation:change-me@127.0.0.1:5432/technovation?schema=public
# For the optional local Docker Compose database. Keep it consistent with DATABASE_URL.
POSTGRES_PASSWORD=change-me
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
# Optional development-only IPv4 address for phone scans over the same Wi-Fi.
# Keep HOST bound to 127.0.0.1. The app starts a separate visitor-only listener.
LAN_QR_HOST=
# Optional HTTPS address of a proxy connected to the visitor-only listener.
QR_PUBLIC_ORIGIN=
TRUST_PROXY=0
UPLOAD_DIRECTORY=./data/uploads
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
# Required only while creating the first administrator. Use at least 14 characters.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Exhibition Administrator
